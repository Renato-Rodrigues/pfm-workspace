# The project repository tracks the project layer only: the root files, analysis/ (code),
# docs/ and records/. See README.md, "What the project repository tracks".

# Separate git repositories, cloned by tools/setup.sh (list in tools/repos.txt)
/models/
/papers/

# Data and results: large, regenerable, or copied from the cluster (README.md, "On the cluster").
# What reproduction needs from them is kept as text in records/<group>/ (ADR 0047).
/data/
/output/

# Rendered figures: regenerated by analysis/figures/build-figures.R (and analysis/figures/pptx/build.js)
/analysis/figures/output/
# The schematics' node toolchain: reinstalled by `npm install` in analysis/figures/pptx/ (package.json pins it)
/analysis/figures/pptx/node_modules/

# R data objects are artifacts, never project files: they belong in output/ (or the archive).
# What reproduction needs is kept as text in records/.
*.rds

# Local tool state
.pfmcfg-*.yml
.proj-*.log
.Rhistory
.RData
.Rproj.user/
__pycache__/
*.Rcheck/
